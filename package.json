{
  "name": "cineindex-api",
  "version": "1.0.0",
  "description": "Backend-focused Movie API with CRUD, filtering, sorting, pagination, auth, validation, and a small API explorer.",
  "license": "ISC",
  "author": "Francis Ol",
  "type": "commonjs",
  "main": "server.js",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node server.js",
    "preview": "node preview.js",
    "dev": "cross-env NODE_ENV=development node --watch server.js",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "seed:import": "node data/import-dev_data.js --import",
    "seed:delete": "node data/import-dev_data.js --delete",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "morgan": "^1.10.1",
    "nodemailer": "^8.0.7",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10"
  },
  "keywords": [
    "node",
    "express",
    "mongodb",
    "mongoose",
    "rest-api",
    "portfolio"
  ]
}
